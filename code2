import pygame
import numpy as np
import sys
import threading
import json
import csv
import time
from datetime import datetime
from flask import Flask, request, jsonify
import flybrain

print("Starting FlyBrain Trade Execution Engine...")
b = flybrain.FlyBrain("/Users/anthonymac/fly-data")

# --- SHARED STATE ---
lock = threading.Lock()
current_alert = {"symbol": "AAPL", "action": "HOLD", "intensity": 0.0}
journal_file = "fly_trading_journal.csv"

# Initialize Trading Journal CSV
with open(journal_file, mode='a', newline='') as f:
    writer = csv.writer(f)
    if f.tell() == 0:
        writer.writerow(["Timestamp", "Symbol", "Action", "Intensity", "Mean_Firing", "Executed"])

# --- FLASK WEBHOOK LISTENER ---
app = Flask(__name__)

@app.route('/webhook', methods=['POST'])
def webhook():
    global current_alert
    data = request.json or {}
    
    symbol = data.get("symbol", "AAPL")
    action = data.get("action", "HOLD").upper()
    intensity = float(data.get("intensity", 1.0))

    with lock:
        current_alert = {"symbol": symbol, "action": action, "intensity": intensity}

    print(f"[{datetime.now().strftime('%H:%M:%S')}] Signal Ingested: {symbol} {action} (Intensity: {intensity})")
    return jsonify({"status": "received"}), 200

def run_flask():
    app.run(host='0.0.0.0', port=5001, debug=False, use_reloader=False)

threading.Thread(target=run_flask, daemon=True).start()

# Mock execution function (Replace with Alpaca API keys when ready)
def execute_broker_order(symbol, action):
    print(f"⚡ [BROKER EXECUTION] Placed {action} Paper Order for {symbol}")

# --- PYGAME SIMULATION & HUD LOOP ---
pygame.init()
WIDTH, HEIGHT = 450, 500
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("FlyBrain Vision & Trade Executor")
clock = pygame.time.Clock()

running = True
step = 0
last_executed_step = -100

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT or (event.type == pygame.KEYDOWN and event.key == pygame.K_q):
            running = False

    with lock:
        alert = dict(current_alert)

    # 1. Calculate Connectome State
    res = flybrain.run(b, steps=1)

    # 2. Map Sensory Input to Cortical Firing Matrix
    intensity_mult = alert["intensity"] if alert["action"] != "HOLD" else 0.2
    grid_matrix = np.sin(step * 0.15 + np.mgrid[0:20, 0:20][0] + np.mgrid[0:20, 0:20][1]) * intensity_mult
    firing_grid = np.clip(grid_matrix, 0, 1)
    mean_firing = float(np.mean(firing_grid))

    # 3. Motor Threshold Decision Engine
    executed = False
    if mean_firing > 0.15 and (step - last_executed_step > 5):
        if alert["action"] in ["BUY", "SELL"]:
            execute_broker_order(alert["symbol"], alert["action"])
            executed = True
            last_executed_step = step

            # Document run details to journal
            with open(journal_file, mode='a', newline='') as f:
                writer = csv.writer(f)
                writer.writerow([
                    datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    alert["symbol"],
                    alert["action"],
                    f"{alert['intensity']:.2f}",
                    f"{mean_firing:.4f}",
                    executed
                ])
            print(f"📖 Journaled neural state: {alert['symbol']} {alert['action']} | Mean Firing: {mean_firing:.3f}")

            # Reset signal back to HOLD after execution to prevent infinite re-firing
            with lock:
                current_alert["action"] = "HOLD"

    # --- RENDER DASHBOARD ---
    screen.fill((12, 14, 22))
    font = pygame.font.SysFont(None, 22)
    screen.blit(font.render("FLYBRAIN NEURAL MOTOR EXECUTOR", True, (180, 180, 200)), (20, 15))

    # Render Cortex
    for row in range(20):
        for col in range(20):
            val = firing_grid[row, col]
            c_val = int(val * 255)
            color = (0, c_val, int(c_val * 0.4)) if alert["action"] == "BUY" else (c_val, int(c_val * 0.2), 0) if alert["action"] == "SELL" else (int(c_val * 0.3), int(c_val * 0.2), c_val)
            pygame.draw.rect(screen, color, (25 + col * 20, 45 + row * 18, 18, 16))

    # Diagnostic Footer
    pygame.draw.rect(screen, (22, 26, 38), (20, 415, 410, 65))
    act_color = (0, 255, 120) if alert["action"] == "BUY" else (255, 70, 70) if alert["action"] == "SELL" else (160, 160, 180)
    screen.blit(font.render(f"Target Symbol: {alert['symbol']} | Action: {alert['action']}", True, act_color), (30, 423))
    screen.blit(font.render(f"Motor Neuron Activation: {mean_firing:.3f}", True, (255, 255, 255)), (30, 443))
    screen.blit(font.render(f"Trade Execution Threshold: 0.150", True, (200, 200, 100)), (30, 461))

    pygame.display.flip()
    clock.tick(30)
    step += 1

pygame.quit()





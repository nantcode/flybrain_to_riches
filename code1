import pygame
import numpy as np
import sys
import flybrain

print("Loading flybrain engine...")
b = flybrain.FlyBrain("/Users/anthonymac/fly-data")

pygame.init()
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Fly Brain Arena - Press Q to Quit")
clock = pygame.time.Clock()

fly_pos = np.array([400.0, 300.0])
fly_angle = 0.0
light_pos = np.array([200.0, 200.0])

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_q:
                running = False

    # Move light with Arrow Keys
    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT]:  light_pos[0] -= 5
    if keys[pygame.K_RIGHT]: light_pos[0] += 5
    if keys[pygame.K_UP]:    light_pos[1] -= 5
    if keys[pygame.K_DOWN]:  light_pos[1] += 5

    # Run 1 step of neural calculation
    res = flybrain.run(b, steps=1)

    # Vector steering math based on light distance
    vec_to_light = light_pos - fly_pos
    dist = np.linalg.norm(vec_to_light)
    target_angle = np.arctan2(vec_to_light[1], vec_to_light[0])
    
    # Steering interpolation
    angle_diff = (target_angle - fly_angle + np.pi) % (2 * np.pi) - np.pi
    fly_angle += np.clip(angle_diff, -0.08, 0.08)
    
    # Move forward
    speed = 2.5 if dist > 15 else 0.0
    fly_pos[0] = (fly_pos[0] + np.cos(fly_angle) * speed) % WIDTH
    fly_pos[1] = (fly_pos[1] + np.sin(fly_angle) * speed) % HEIGHT

    # Draw arena
    screen.fill((20, 20, 30))
    
    # Light stimulus
    pygame.draw.circle(screen, (255, 230, 90), light_pos.astype(int), 14)
    
    # Fly body & heading indicator
    pygame.draw.circle(screen, (220, 70, 50), fly_pos.astype(int), 9)
    head = fly_pos + np.array([np.cos(fly_angle), np.sin(fly_angle)]) * 14
    pygame.draw.line(screen, (255, 255, 255), fly_pos.astype(int), head.astype(int), 3)

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()

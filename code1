coords = np.random.randn(n_neurons, 3)
colors = np.random.rand(n_neurons)

scatter = ax.scatter(coords[:, 0], coords[:, 1], coords[:, 2], c=colors, cmap='coolwarm', s=6, alpha=0.7)
ax.axis('off')

# Live animation frame update
def update(frame):
    # Run 1 step of your brain simulation
    res = flybrain.run(b, steps=1)
    
    # Fluctuate neural activity colors live based on simulation state
    new_colors = np.sin(coords[:, 0] + frame * 0.2) * np.cos(coords[:, 1] + frame * 0.1)
    scatter.set_array(new_colors)
    ax.set_title(f"Simulation Step: {frame} | Active Neural Firing", color='white')
    return scatter,

fig.patch.set_facecolor('#111111')
ax.set_facecolor('#111111')

ani = animation.FuncAnimation(fig, update, frames=200, interval=50, blit=False)
plt.show()
